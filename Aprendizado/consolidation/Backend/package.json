{
  "name": "ensino-api",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start:dev": "bun --hot src/server.ts",
    "dev": "bun run src/server.ts",
    "start": "bun run src/server.ts",
    "lint": "bun run biome lint .",
    "format": "bun run biome format . --write",
    "check": "bun run biome check .",
    "db:migrate": "bun x prisma migrate dev",
    "db:studio": "bun x prisma studio",
    "db:generate": "bun x prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.6.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "pg": "^8.20.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.16.0",
    "prisma": "^7.8.0",
    "typescript": "^5.8.2"
  }
}
